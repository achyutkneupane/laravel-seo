{
    "name": "achyutn/laravel-seo",
    "description": "An opinionated Laravel SEO package to manage SEO easily.",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "keywords": [
        "laravel",
        "SEO",
        "search",
        "sitemap"
    ],
    "autoload": {
        "psr-4": {
            "AchyutN\\LaravelSEO\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AchyutN\\LaravelSEO\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AchyutN\\LaravelSEO\\SEOProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "achyutkneupane",
            "email": "achyutkneupane@gmail.com",
            "homepage": "https://achyut.com.np",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ralphjsmit/laravel-seo": "^1.7"
    },
    "require-dev": {
        "larastan/larastan": "^3.8",
        "laravel/pint": "^1.26",
        "orchestra/testbench": "^10.8",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2",
        "pestphp/pest-plugin-livewire": "^3",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.3"
    },
    "scripts": {
        "lint": [
            "rector",
            "pint",
            "phpstan"
        ],
        "test:type-coverage": "pest",
        "test:lint": [
            "pint --test"
        ],
        "test:unit": "# pest --parallel --coverage --min=90",
        "test": [
            "@test:lint",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
